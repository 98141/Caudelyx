# Perfil S02: servicio Mongo existente. No contiene secretos ni controla mongod.
CAUDELYX_MODE=local-synthetic
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=caudelyx_dev
# Opcionales: puertos distintos para pruebas aisladas.
CAUDELYX_DEV_UI_PORT=3001
CAUDELYX_DEV_API_PORT=4001
CAUDELYX_DEV_PLATFORM_PORT=3002
# Claves, TLS y evidencia persistentes: servidor/.runtime/installed-control
# Primera inicialización reutiliza el certificado local ya autorizado de manual-control.
